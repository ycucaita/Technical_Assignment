<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Pull in Spring Boot's colour/converter defaults so %clr(...) etc. work. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console pattern with the correlation id in brackets. %X{correlationId:-} reads the MDC
         value populated by MdcCorrelationIdAccessor via Reactor context propagation; the ':-'
         renders an empty string for lines emitted outside a request (startup, schedulers). -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{correlationId:-}]){yellow} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
